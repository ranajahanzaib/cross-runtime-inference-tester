{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cross-runtime-inference-tester.dev/schemas/numerical-comparison-1.0.0.json",
  "title": "Cross-Runtime Inference Tester numerical comparison",
  "type": "object",
  "required": [
    "case_id",
    "reference_runtime",
    "target_runtime",
    "reference_output",
    "target_output",
    "max_absolute_difference",
    "max_relative_difference",
    "within_tolerance",
    "status"
  ],
  "properties": {
    "case_id": { "type": "string" },
    "reference_runtime": { "type": "string" },
    "target_runtime": { "type": "string" },
    "reference_output": {},
    "target_output": {},
    "max_absolute_difference": { "type": "number", "minimum": 0 },
    "max_relative_difference": { "type": "number", "minimum": 0 },
    "mean_absolute_difference": { "type": "number", "minimum": 0 },
    "rmse": { "type": "number", "minimum": 0 },
    "tolerance_limit": { "type": "number", "minimum": 0 },
    "within_tolerance": { "type": "boolean" },
    "class_agreement": { "type": ["boolean", "null"] },
    "status": {
      "enum": ["PASS", "WARNING", "FAIL", "SKIPPED", "UNSUPPORTED", "ERROR"]
    }
  }
}
