{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cross-runtime-inference-tester.dev/schemas/benchmark-result-1.0.0.json",
  "title": "Cross-Runtime Inference Tester benchmark result",
  "type": "object",
  "required": [
    "schema_version",
    "runtime_id",
    "model_sha256",
    "environment",
    "initialization_ms",
    "iterations",
    "batch_size",
    "latency_ms"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "runtime_id": { "type": "string" },
    "model_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "environment": { "type": "object" },
    "initialization_ms": { "type": "number", "minimum": 0 },
    "first_inference_ms": { "type": "number", "minimum": 0 },
    "warmup_iterations": { "type": "integer", "minimum": 0 },
    "iterations": { "type": "integer", "minimum": 1 },
    "batch_size": { "type": "integer", "minimum": 1 },
    "latency_ms": {
      "type": "object",
      "required": ["median", "mean", "p95", "min", "max"]
    },
    "batch_workloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "batch_size",
          "iterations",
          "warmup_iterations",
          "latency_ms",
          "throughput_rows_per_second"
        ],
        "properties": {
          "batch_size": { "type": "integer", "minimum": 1 },
          "iterations": { "type": "integer", "minimum": 1 },
          "warmup_iterations": { "type": "integer", "minimum": 0 },
          "latency_ms": {
            "type": "object",
            "required": ["median", "mean", "p95", "p99", "min", "max", "stdev"]
          },
          "throughput_rows_per_second": {
            "type": ["number", "null"],
            "minimum": 0
          }
        }
      }
    },
    "independent_run_count": { "type": "integer", "minimum": 1 },
    "independent_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_index",
          "session_initialization_ms",
          "first_inference_ms",
          "batch_workloads"
        ],
        "properties": {
          "run_index": { "type": "integer", "minimum": 1 },
          "session_initialization_ms": { "type": "number", "minimum": 0 },
          "first_inference_ms": { "type": "number", "minimum": 0 },
          "batch_workloads": { "type": "array" }
        }
      }
    }
  }
}
