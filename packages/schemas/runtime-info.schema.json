{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cross-runtime-inference-tester.dev/schemas/runtime-info-1.0.0.json",
  "title": "Cross-Runtime Inference Tester runtime information",
  "type": "object",
  "required": ["runtime_id", "provider", "status"],
  "properties": {
    "runtime_id": { "type": "string" },
    "provider": { "type": "string" },
    "status": { "enum": ["executed", "unsupported", "error", "unavailable"] },
    "version": { "type": ["string", "null"] },
    "initialization_ms": { "type": ["number", "null"], "minimum": 0 },
    "model_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capabilities": { "type": "object" },
    "environment": { "type": "object" }
  }
}
